import com.naver.service.Person;
import com.naver.service.Person2;
import com.naver.service.Student;
import com.naver.service.Student2;

public class JavaEssential {
	public static void main(String[] args) {
		Person p=new Person();
		p.name="홍길동"; // public이므로 접근 가능
		System.out.print(p.name);
		System.out.print(": ");
		p.sleep(); // public이므로 접근 가능
		
		Person2 p2=new Person2(); 
//		p2.name="이순신"; // private라서 접근 불가능
		p2.setName("이순신"); // setter 사용. 저장.
		System.out.print(p2.getName()); // getter 사용. 읽기.
		System.out.print(": ");
		p2.sleep(); // public이므로 접근 가능
		
		Student s=new Student();
		s.name="왕건";
		s.department="철학과";
		System.out.print(s.name);
		System.out.print(": ");
		s.sleep();
//		s.study(); // default 접근제한자이므로 접근 불가
		
		Person p3=new Person("을지문덕");
		System.out.println(p3.name);
		
		Student s2=new Student();
		System.out.print(s2.name);
		System.out.print("는 ");
		s2=new Student("강감찬","컴퓨터공학과");
		System.out.print(s2.department+" "+s2.name);
		
//		Person3 p4=new Person3(); // interface는 instance 생성 불가
		Student2 s3=new Student2();
		s3.name="";
		s3.department="";
	}
}